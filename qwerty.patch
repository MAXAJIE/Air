+/** Normalises the three provider shapes into one GeoResult. */
+async function lookupIp(url: string): Promise<GeoResult | null> {
+  try {
+    const response = await fetch(url, { headers: { "User-Agent": "keyward-app/1.0 (ip locate)" } });
