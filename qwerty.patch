+  const request = getRequest();
+  const method = request.method.toUpperCase();
+  if (method !== "GET" && method !== "HEAD" && !isTrustedRequestOrigin(request)) {
+    return new Response("Cross-site request blocked", { status: 403 });
+  }
+  return next();
